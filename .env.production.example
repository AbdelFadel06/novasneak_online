# Copy to .env on the VPS (never commit the real file). Every value below
# marked "CHANGE ME" must be replaced with a real, unique secret — this
# file is only safe as a documented template.

# --- Domains (used by Caddy and by the frontend/backend to know their own URL) ---
DOMAIN=example.com
UMAMI_DOMAIN=analytics.example.com

# --- Postgres ---
POSTGRES_DB=novasneak
POSTGRES_USER=novasneak
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-hex-32

# --- Django ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com
CORS_ALLOWED_ORIGINS=https://example.com

# Superuser is only auto-created if BOTH the username and this exact combo
# don't already exist — after the first deploy, change the password via
# `docker compose exec backend python manage.py changepassword admin`
# and you can leave these as-is (they won't re-run).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE-ME-strong-password
DJANGO_SUPERUSER_EMAIL=you@example.com

# --- Umami analytics ---
# Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=CHANGE-ME
# Leave empty on first deploy, fill in after creating the website in the
# Umami dashboard (see DEPLOY.md), then redeploy the frontend.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
