# Postgres
POSTGRES_DB=novasneak
POSTGRES_USER=novasneak
POSTGRES_PASSWORD=novasneak

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: auto-create a Django superuser on first boot
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin1234
DJANGO_SUPERUSER_EMAIL=admin@novasneak.local

# Umami analytics (self-hosted, see docker-compose.yml "umami" service)
UMAMI_APP_SECRET=change-me-generate-a-random-string
NEXT_PUBLIC_UMAMI_SRC=http://localhost:3001/script.js
# Fill in after creating the website at http://localhost:3001, then restart the frontend
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
